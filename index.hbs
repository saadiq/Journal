{{!< default}}

<main id="gh-main" class="gh-main gh-outer">
    <div class="gh-inner">
        {{^is "paged"}}
            <section class="fn-manifesto">
                <span class="fn-manifesto-label">// what i do</span>
                <h2 class="fn-manifesto-text">
                    Your team has the tools. <em>Nothing has changed.</em>
                </h2>
                <p class="fn-manifesto-sub">That's the problem I solve. Notes from the work.</p>
                <a href="https://saadiq.xyz" class="fn-manifesto-link">work with me &rarr;</a>
            </section>
            {{#foreach posts limit="1"}}
                <article class="gh-latest gh-card {{post_class}}{{#if feature_image}} has-feature{{/if}}">
                    <a class="gh-card-link" href="{{url}}">
                        {{#if feature_image}}
                            <figure class="gh-latest-image">
                                <img src="{{img_url feature_image size="xl"}}"
                                     srcset="{{img_url feature_image size="m"}} 720w, {{img_url feature_image size="l"}} 960w, {{img_url feature_image size="xl"}} 1200w"
                                     sizes="(max-width: 900px) 100vw, 60vw"
                                     alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
                                     loading="eager">
                            </figure>
                        {{/if}}

                        <div class="gh-latest-body">
                            <header class="gh-card-header">
                                <div class="gh-article-meta gh-article-meta-row">
                                    <span class="gh-article-hash-label is-head">HEAD <span class="gh-card-hash" title="{{id}}">{{id}}</span></span>
                                    <span class="gh-card-sep">/</span>
                                    <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="YYYY-MM-DD"}}</time>
                                    <span class="gh-card-sep">/</span>
                                    <span class="gh-card-duration">{{reading_time minute=(t "1 min read") minutes=(t "% min read")}}</span>
                                </div>
                                <h2 class="gh-article-title gh-card-title">{{title}}</h2>
                            </header>

                            <p class="gh-article-excerpt">{{excerpt}}</p>

                            <div class="gh-article-byline">
                                <span class="gh-article-byline-avatar" aria-hidden="true"></span>
                                <span>by <strong>{{authors autolink="false"}}</strong></span>
                                <span class="gh-article-sep">/</span>
                                <span>brooklyn</span>
                                <span class="gh-article-sep">/</span>
                                <span>strategy → commits</span>
                            </div>

                            <footer class="gh-card-meta">
                                {{#if @site.comments_enabled}}
                                    {{comment_count class="gh-card-comments"}}
                                {{/if}}
                                {{^has visibility="public"}}
                                    {{> icons/star}}
                                {{/has}}
                            </footer>
                        </div>
                    </a>
                </article>
            {{/foreach}}
        {{/is}}

        <div class="gh-wrapper is-single-column">
            <section class="gh-section">
                <h2 class="gh-section-title">before</h2>

                <div class="gh-feed">
                    {{^is "paged"}}
                        {{#foreach posts from="2"}}
                            {{> loop}}
                        {{/foreach}}
                    {{else}}
                        {{#foreach posts}}
                            {{> loop}}
                        {{/foreach}}
                    {{/is}}
                </div>

                {{#match posts.length "=" 1}}
                    {{t "Additional issues will be published soon."}}
                {{/match}}

                <button class="gh-loadmore gh-btn">load more commits</button>
            </section>
        </div>
    </div>
</main>