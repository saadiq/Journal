<div class="gh-share-bar gh-share-bar-{{variant}}" data-share-url="{{url absolute="true"}}" data-share-title="{{title}}">
    <span class="gh-share-label">$ share</span>
    <div class="gh-share-buttons">
        <a class="gh-share-btn" data-share-x href="https://twitter.com/intent/tweet?text={{encode title}}&url={{encode (url absolute="true")}}" target="_blank" rel="noopener" aria-label="Share on X">
            {{> "icons/twitter"}}<span>x</span>
        </a>
        <a class="gh-share-btn" data-share-linkedin href="https://www.linkedin.com/sharing/share-offsite/?url={{encode (url absolute="true")}}" target="_blank" rel="noopener" aria-label="Share on LinkedIn">
            {{> "icons/linkedin"}}<span>linkedin</span>
        </a>
        <a class="gh-share-btn" data-share-bluesky href="https://bsky.app/intent/compose?text={{encode title}}%20{{encode (url absolute="true")}}" target="_blank" rel="noopener" aria-label="Share on Bluesky">
            {{> "icons/bluesky"}}<span>bluesky</span>
        </a>
        <a class="gh-share-btn" data-share-email href="mailto:?subject={{encode title}}&body={{encode (url absolute="true")}}" aria-label="Share via email">
            {{> "icons/email"}}<span>email</span>
        </a>
        <button type="button" class="gh-share-btn" data-share-copy aria-label="Copy link">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 17H7A5 5 0 0 1 7 7h2"/><path d="M15 7h2a5 5 0 1 1 0 10h-2"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
            <span class="gh-share-copy-label">copy link</span>
        </button>
    </div>
</div>
