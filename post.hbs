{{!< default}}

{{#post}}

<main id="gh-main" class="gh-main">
    <article class="gh-article {{post_class}}">

        <header class="gh-article-header gh-canvas">
            <div class="gh-article-meta-row">
                {{#if primary_tag}}
                    <a class="gh-article-tag" href="{{primary_tag.url}}">{{primary_tag.name}}</a>
                {{/if}}
                {{#get "posts" limit="1" order="published_at desc" filter="status:published" as |latest|}}
                    {{#foreach latest}}
                        {{#match id "=" ../../id}}
                            <span class="gh-article-hash-label is-head">HEAD <span class="gh-card-hash" title="{{../../id}}">{{../../id}}</span></span>
                        {{else}}
                            <span class="gh-article-hash-label"><span class="gh-card-hash" title="{{../../id}}">{{../../id}}</span></span>
                        {{/match}}
                    {{/foreach}}
                {{/get}}
                <span class="gh-article-sep">/</span>
                <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="YYYY-MM-DD"}}</time>
                <span class="gh-article-sep">/</span>
                <span>{{reading_time minute="1 min read" minutes="% min read"}}</span>
            </div>

            <h1 class="gh-article-title">{{title}}</h1>

            {{#if custom_excerpt}}
                <p class="gh-article-excerpt">{{custom_excerpt}}</p>
            {{/if}}

            <div class="gh-article-byline">
                <span class="gh-article-byline-avatar" aria-hidden="true"></span>
                <span>by <strong>{{authors}}</strong></span>
                <span class="gh-article-sep">/</span>
                <span>brooklyn</span>
                <span class="gh-article-sep">/</span>
                <span>strategy → commits</span>
            </div>

            {{> "share-bar" variant="top"}}

            {{> "feature-image"}}
        </header>

        <div class="gh-content gh-canvas">
            {{content}}
        </div>

        {{> "consulting-cta"}}

        {{#if comments}}
            <div class="gh-comments gh-canvas">
                {{comments}}
            </div>
        {{/if}}

        <footer class="gh-article-footer gh-canvas{{#if @site.comments_enabled}}{{#unless @member}} no-border{{/unless}}{{#unless access}} no-border{{/unless}}{{/if}}">
            {{> "share-bar" variant="bottom"}}

            <nav class="gh-navigation">
                <div class="gh-navigation-previous">
                    {{#prev_post}}
                        <a class="gh-navigation-link" href="{{url}}">
                            <span class="gh-navigation-label">{{> icons/arrow-left}} Previous issue</span>
                            <h4 class="gh-navigation-title">{{title}}</h4>
                        </a>
                    {{/prev_post}}
                </div>

                <div class="gh-navigation-next">
                    {{#next_post}}
                        <a class="gh-navigation-link" href="{{url}}">
                            <span class="gh-navigation-label">Next issue {{> icons/arrow-right}}</span>
                            <h4 class="gh-navigation-title">{{title}}</h4>
                        </a>
                    {{/next_post}}
                </div>
            </nav>
        </footer>

    </article>
</main>

{{/post}}